\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Indicad cómo se comunican y comparad USB-A, USB-C, USB4, Thunderbolt, HDMI, DisplayPort y Ethernet. Aclarad que la forma USB-C no garantiza salida de vídeo.}{18}{subsection.6.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Diseñad y dibujad un esquema de conexión de portátil, monitor HDMI, monitor DisplayPort, teclado, ratón, Ethernet y alimentación.}{19}{subsection.6.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {6.3.1}Si proponéis un dock, indicad modelo, precio y compatibilidad con el portátil. Aportad evidencia de que funcionan simultáneamente la pantalla integrada y las dos pantallas externas en modo escritorio extendido, teniendo en cuenta puertos, resolución y frecuencia. Tener dos conectores de vídeo no constituye prueba suficiente.}{19}{subsubsection.6.3.1}\protected@file@percent }
