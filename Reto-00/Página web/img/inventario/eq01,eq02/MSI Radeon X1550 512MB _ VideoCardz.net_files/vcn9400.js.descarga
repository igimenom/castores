// Theme detection is now handled in header.php to prevent flicker
// This file now only handles toggle functionality

// Guard to prevent multiple executions
if (window.vcScriptLoaded) {
    // Script already loaded, exit
    throw new Error('VC script already loaded');
}
window.vcScriptLoaded = true;

/* =============================================================================
 * Shareon — embedded fork (https://shareon.js.org)
 * Source of truth for upgrades: vc9300s/shareon/shareon.iife.js (and .min.css)
 * Removed from this fork: linkedin, pinterest, tumblr, vkontakte, odnoklassniki,
 * fediverse, mastodon, pocket, print
 * ============================================================================= */
var Shareon = (function (r) {
  'use strict';
  var o = {
    facebook: function (t) {
      return 'https://www.facebook.com/sharer/sharer.php?u=' + t.url + (t.hashtags ? '&hashtag=%23' + t.hashtags.split('%2C')[0] : '');
    },
    email: function (t) {
      return 'mailto:?subject=' + t.title + '&body=' + t.url;
    },
    messenger: function (t) {
      return 'https://www.facebook.com/dialog/send?app_id=' + t.fbAppId + '&link=' + t.url + '&redirect_uri=' + t.url;
    },
    reddit: function (t) {
      return 'https://www.reddit.com/submit?title=' + t.title + '&url=' + t.url;
    },
    teams: function (t) {
      return 'https://teams.microsoft.com/share?href=' + t.url + (t.text ? '&msgText=' + t.text : '');
    },
    telegram: function (t) {
      return 'https://telegram.me/share/url?url=' + t.url + (t.text ? '&text=' + t.text : '');
    },
    twitter: function (t) {
      return 'https://twitter.com/intent/tweet?url=' + t.url + '&text=' + t.title + (t.via ? '&via=' + t.via : '') + (t.hashtags ? '&hashtags=' + t.hashtags : '');
    },
    viber: function (t) {
      return 'viber://forward?text=' + t.title + '%0D%0A' + t.url + (t.text ? '%0D%0A%0D%0A' + t.text : '');
    },
    whatsapp: function (t) {
      return 'https://wa.me/?text=' + t.title + '%0D%0A' + t.url + (t.text ? '%0D%0A%0D%0A' + t.text : '');
    },
  };
  var $open = function (t) {
    return function () {
      window.open(t, '_blank', 'noopener,noreferrer');
    };
  };
  var initShareon = function () {
    var roots = document.querySelectorAll('.shareon');
    for (var ri = 0; ri < roots.length; ri++) {
      var a = roots[ri];
      var children = a.children;
      for (var ci = 0; ci < children.length; ci++) {
        var e = children[ci];
        if (!e) continue;
        var plen = e.classList.length;
        for (var n = 0; n < plen; n++) {
          var cls = e.classList.item(n);
          if (cls === 'copy-url') {
            e.addEventListener('click', function (el, root) {
              return function () {
                var u = el.dataset.url || root.dataset.url || window.location.href;
                navigator.clipboard.writeText(u);
                el.classList.add('done');
                setTimeout(function () {
                  el.classList.remove('done');
                }, 1000);
              };
            }(e, a));
          }
          if (cls === 'web-share') {
            var ws = {
              title: e.dataset.title || a.dataset.title || document.title,
              text: e.dataset.text || a.dataset.text || '',
              url: e.dataset.url || a.dataset.url || window.location.href,
            };
            if (navigator.canShare && navigator.canShare(ws)) {
              e.addEventListener('click', function (payload) {
                return function () {
                  navigator.share(payload);
                };
              }(ws));
            } else {
              e.style.display = 'none';
            }
          }
          if (Object.prototype.hasOwnProperty.call(o, cls)) {
            var s = {
              url: encodeURIComponent(e.dataset.url || a.dataset.url || window.location.href),
              title: encodeURIComponent(e.dataset.title || a.dataset.title || document.title),
              media: encodeURIComponent(e.dataset.media || a.dataset.media || ''),
              text: encodeURIComponent(e.dataset.text || a.dataset.text || ''),
              via: encodeURIComponent(e.dataset.via || a.dataset.via || ''),
              hashtags: encodeURIComponent(e.dataset.hashtags || a.dataset.hashtags || ''),
              fbAppId: encodeURIComponent(e.dataset.fbAppId || a.dataset.fbAppId || ''),
              s2fInstance: encodeURIComponent(e.dataset.s2fInstance || a.dataset.s2fInstance || 's2f.kytta.dev'),
            };
            var h = o[cls](s);
            if (e.tagName.toLowerCase() === 'a') {
              e.setAttribute('href', h);
              e.setAttribute('rel', 'noopener noreferrer');
              e.setAttribute('target', '_blank');
            } else {
              e.addEventListener('click', $open(h));
            }
            break;
          }
        }
      }
    }
  };
  r.init = initShareon;
  Object.defineProperty(r, Symbol.toStringTag, { value: 'Module' });
  return r;
})({});

// Write a cookie with expiry and secure attributes.
function setCookie(cname, cvalue, exdays) {
	var d = new Date();
	d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
	var expires = "expires=" + d.toUTCString();
	var cookieString = cname + "=" + cvalue + ";" + expires + " ;SameSite=None; Secure; Path=/ ";
	document.cookie = cookieString;
}

// Read a cookie value by cookie name.
function getCookie(cname) {
	var name = cname + "=";
	var ca = document.cookie.split(';');
	
	for (var i = 0; i < ca.length; i++) {
		var c = ca[i];
		while (c.charAt(0) == ' ') {
			c = c.substring(1);
		}
		if (c.indexOf(name) == 0) {
			var value = c.substring(name.length, c.length);
			return value;
		}
	}
	return "";
}

// Set default cookies if they don't exist

if (getCookie("vc-comment") === "") {
	setCookie('vc-comment', 'show', 365);
}

// Subcategory description toggle function
// Toggle category description expanded/collapsed state.
function toggleSubcategoryDescription() {
	const article = document.querySelector("article.category-description");
	const btn = document.querySelector(".subcategory-read-more-btn");
	
	if (article && btn) {
		// Get computed style to see actual current state
		const computedStyle = window.getComputedStyle(article);
		const currentMaxHeight = computedStyle.maxHeight;
		
		// Check if currently collapsed (200px or similar) or expanded (none)
		const isCollapsed = currentMaxHeight !== 'none' && currentMaxHeight !== 'auto';
		
		if (isCollapsed) {
			// Currently collapsed - expand it
			article.style.maxHeight = "none";
			article.style.overflow = "visible";
			btn.textContent = "Read Less";
		} else {
			// Currently expanded - collapse it
			article.style.maxHeight = "200px";
			article.style.overflow = "hidden";
			btn.textContent = "Read More";
		}
	}
}

// Main DOM-ready bootstrap for site UI features.
function onDOMReady() {
  // Theme toggle functionality (state is initialized in header.php for no-flicker paint)
  // Sync theme toggle control to current theme state.
  function setThemeToggleButtonState() {
    var currentTheme = document.documentElement.getAttribute('data-theme');
    var toggleTrack = document.getElementById('toggle-track');
    var toggleSwitch = document.querySelector('.theme-toggle input[type="checkbox"]');
    if (toggleTrack) toggleTrack.setAttribute('data-state', currentTheme === 'light' ? 'light' : 'dark');
    if (toggleSwitch) toggleSwitch.checked = currentTheme === 'light';
  }

  // Apply theme attribute to Twitter embeds on load.
  function applyTwitterEmbedThemeOnLoad() {
    var currentTheme = document.documentElement.getAttribute('data-theme');
    var embedTheme = currentTheme === 'dark' ? 'dark' : 'light';
    var tweetBlocks = document.querySelectorAll('blockquote.twitter-tweet');
    var timelineAnchors = document.querySelectorAll('a.twitter-timeline');

    tweetBlocks.forEach(function(block) {
      block.setAttribute('data-theme', embedTheme);
    });

    timelineAnchors.forEach(function(anchor) {
      anchor.setAttribute('data-theme', embedTheme);
    });
  }

  // Switch light/dark theme and persist preference.
  function cycleTheme() {
    var currentTheme = document.documentElement.getAttribute('data-theme');
    var newTheme = currentTheme === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', newTheme);
    setCookie('vc-theme', newTheme, 365);
    setThemeToggleButtonState();
  }

  setThemeToggleButtonState();
  applyTwitterEmbedThemeOnLoad();

  document.addEventListener('change', function(e) {
    if (e.target.matches('.theme-toggle input[type="checkbox"]')) cycleTheme();
  });

  document.addEventListener('click', function(e) {
    var track = e.target.closest('#toggle-track');
    if (track) {
      e.preventDefault();
      cycleTheme();
    }
  });

  // Mobile menu collapsible sections functionality
  // Initialize expandable/collapsible sections in mobile nav.
  function initMobileMenuCollapsible() {
    const menuSectionHeaders = document.querySelectorAll('#vc-mobile-menu .menu-section-header');
    
    menuSectionHeaders.forEach(header => {
      // Skip non-collapsible sections
      if (header.classList.contains('non-collapsible')) {
        return;
      }
      
      // Initialize toggle icon rotation based on initial state
      const toggleIcon = header.querySelector('.toggle-icon');
      const content = header.nextElementSibling;
      
      if (content && content.classList.contains('menu-section-content')) {
        const isCollapsed = content.classList.contains('collapsed');
        if (toggleIcon) {
          toggleIcon.style.transform = isCollapsed ? 'rotate(-90deg)' : 'rotate(0deg)';
        }
      }
      
      header.addEventListener('click', function(e) {
        // Check if the click was on a link
        const link = e.target.closest('a');
        if (link) {
          // Let the link navigate normally
          return;
        }
        
        // If not on a link, toggle the section
        e.preventDefault();
        
        const content = this.nextElementSibling;
        const toggleIcon = this.querySelector('.toggle-icon');
        
        if (content && content.classList.contains('menu-section-content')) {
          // Toggle collapsed state
          const isCollapsed = content.classList.contains('collapsed');
          
          if (isCollapsed) {
            // Collapse all other collapsible sections first (exclude non-collapsible sections)
            const allHeaders = document.querySelectorAll('#vc-mobile-menu .menu-section-header:not(.non-collapsible)');
            const allContents = document.querySelectorAll('#vc-mobile-menu .menu-section-content');
            
            allHeaders.forEach(otherHeader => {
              if (otherHeader !== this && !otherHeader.classList.contains('non-collapsible')) {
                otherHeader.classList.add('collapsed');
                const otherToggleIcon = otherHeader.querySelector('.toggle-icon');
                if (otherToggleIcon) {
                  otherToggleIcon.style.transform = 'rotate(-90deg)';
                }
              }
            });
            
            allContents.forEach(otherContent => {
              if (otherContent !== content) {
                // Only collapse if the parent header is not non-collapsible
                const parentHeader = otherContent.previousElementSibling;
                if (parentHeader && !parentHeader.classList.contains('non-collapsible')) {
                  otherContent.classList.add('collapsed');
                }
              }
            });
            
            // Expand current section
            content.classList.remove('collapsed');
            this.classList.remove('collapsed');
            if (toggleIcon) {
              toggleIcon.style.transform = 'rotate(0deg)';
            }
          } else {
            // Collapse current section
            content.classList.add('collapsed');
            this.classList.add('collapsed');
            if (toggleIcon) {
              toggleIcon.style.transform = 'rotate(-90deg)';
            }
          }
        }
      });
    });
  }

  // Initialize mobile menu functionality
  initMobileMenuCollapsible();

  // Hide empty cat-year spans
  // Hide empty year labels in mobile menu lists.
  function hideEmptyCatYears() {
    const catYears = document.querySelectorAll('#vc-mobile-menu .cat-year');
    catYears.forEach(span => {
      const text = span.textContent.trim();
      if (text === '' || text === '&nbsp;' || text === '\u00A0') {
        span.classList.add('hidden');
      }
    });
  }

  // Run on page load and when menu opens
  hideEmptyCatYears();
  
  // Also run when mobile menu is opened
  const mobileMenuToggle = document.getElementById('vc-mobile-menu-toggle-input');
  if (mobileMenuToggle) {
    mobileMenuToggle.addEventListener('change', function() {
      if (this.checked) {
        setTimeout(hideEmptyCatYears, 100); // Small delay to ensure content is loaded
      }
    });
  }

  // Comment policy toggle
  if (document.getElementById("vc-maincontainer-disqus-policy")) {
    const toggleSwitch2 = document.querySelector('.comment-policy-switch input[type="checkbox"]');
    const currentCommentPolicy = getCookie('vc-comment');
    if (currentCommentPolicy) {
      document.documentElement.setAttribute('data-comment', currentCommentPolicy);
      if (currentCommentPolicy === 'hide') {
        toggleSwitch2.checked = true;
        document.getElementById("vc-maincontainer-disqus-policy").style.display = "none";
      }
    }
    // Toggle comments visibility preference and cookie value.
    function switchCommentPolicy(e) {
      if (e.target.checked) {
        document.documentElement.setAttribute('data-comment', 'show');
        setCookie('vc-comment', 'hide', 365);
        document.getElementById("vc-maincontainer-disqus-policy").style.display = "none";
      } else {
        document.documentElement.setAttribute('data-comment', 'show');
        setCookie('vc-comment', 'show', 365);
        document.getElementById("vc-maincontainer-disqus-policy").style.display = "block";
      }
    }
    toggleSwitch2.addEventListener('change', switchCommentPolicy, false);
  }

  // Sticky menu
  const stickyElm = document.getElementById('vc-main-navigation');
  if (stickyElm) {
    const stickySentinel = document.createElement('div');
    stickySentinel.setAttribute('aria-hidden', 'true');
    stickySentinel.style.display = 'block';
    stickySentinel.style.width = '100%';
    stickySentinel.style.height = '1px';
    stickySentinel.style.margin = '0';
    stickySentinel.style.padding = '0';
    stickySentinel.style.pointerEvents = 'none';
    stickyElm.parentNode.insertBefore(stickySentinel, stickyElm);

    const observer = new IntersectionObserver(
      ([entry]) => {
        stickyElm.classList.toggle('addShadow', !entry.isIntersecting);
      },
      {
        threshold: [0]
      }
    );
    observer.observe(stickySentinel);

    // Scroll-progress light along nav border
    let scrollProgressRaf = null;
    // Compute and set sticky-nav scroll progress variable.
    function updateScrollProgress() {
      const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const progress = maxScroll <= 0 ? 0 : Math.min(1, Math.max(0, window.scrollY / maxScroll));
      stickyElm.style.setProperty('--scroll-progress', progress);
      scrollProgressRaf = null;
    }
    // Throttle scroll progress updates through rAF.
    function onScrollProgressRequest() {
      if (scrollProgressRaf == null) {
        scrollProgressRaf = requestAnimationFrame(updateScrollProgress);
      }
    }
    window.addEventListener('scroll', onScrollProgressRequest, { passive: true });
    window.addEventListener('resize', function() {
      onScrollProgressRequest();
    });
    updateScrollProgress();
  }

  // Initialize database video functionality
  initDatabaseVideos();
  
  // Initialize gallery functionality (post/shortcode)
  initVCGallery();
  // Initialize database gallery (card/GPU)
  initVCNGallery();
  
  // Initialize Disqus count processing
  initDisqusCountGlobalScript();
  
  // Initialize load more functionality
  initLoadMore();

  // Shareon (embedded fork — upstream reference: vc9300s/shareon/shareon.iife.js)
  if (typeof Shareon !== 'undefined' && typeof Shareon.init === 'function') {
    Shareon.init();
  }

  // Copy protection (tiered limits + attribution for article content)
  initCopyProtection();

  // Search overlay functionality
  const searchIconToggle = document.getElementById('search-icon-toggle');
  const searchOverlay = document.getElementById('search-overlay');
  const closeSearchButton = document.getElementById('close-search-button');

  if (searchIconToggle && searchOverlay && closeSearchButton) {
    var clearLiveSearch = initSearchOverlayLive(searchOverlay);

    // Close search overlay and reset live-search state.
    function closeSearchOverlay() {
      if (typeof clearLiveSearch === 'function') {
        clearLiveSearch();
      }
      searchOverlay.classList.remove('active');
    }

    searchIconToggle.addEventListener('click', function(e) {
      e.preventDefault();
      searchOverlay.classList.add('active');

      setTimeout(function() {
        const searchInput = searchOverlay.querySelector('.search-field');
        if (searchInput) {
          searchInput.focus();
        }
      }, 100);
    });

    closeSearchButton.addEventListener('click', function() {
      closeSearchOverlay();
    });

    document.addEventListener('keydown', function(e) {
      if (searchOverlay.classList.contains('active')) {
        if (e.key === 'Escape') {
          closeSearchOverlay();
        }
      }
    });

    searchOverlay.addEventListener('click', function(e) {
      if (e.target === searchOverlay) {
        closeSearchOverlay();
      }
    });
  }
}

/**
 * Live search in overlay: REST suggestions + instant results (min 3 chars, debounced).
 * @param {HTMLElement} searchOverlay Root #search-overlay
 * @returns {function|undefined} Clear function for live panel state
 */
// Initialize live search behavior in the search overlay.
function initSearchOverlayLive(searchOverlay) {
  if (typeof blog === 'undefined' || !blog.vcSearchRestUrl) {
    return undefined;
  }

  var input = searchOverlay.querySelector('#search-overlay-field');
  var live = document.getElementById('vc-search-live');
  if (!input || !live) {
    return undefined;
  }

  var statusEl = document.getElementById('vc-search-live-status');
  var loadingEl = document.getElementById('vc-search-loading');
  var didYouMeanEl = document.getElementById('vc-search-did-you-mean');
  var sugWrap = document.getElementById('vc-search-suggestions-wrap');
  var sugList = document.getElementById('vc-search-suggestions');
  var resWrap = document.getElementById('vc-search-results-wrap');
  var resList = document.getElementById('vc-search-results');
  var allLink = document.getElementById('vc-search-all');

  var debounceTimer = null;
  var abortController = null;
  var VC_SEARCH_MIN = 3;
  var VC_SEARCH_DEBOUNCE_MS = 1000;

  /**
   * Decode HTML entities so titles show curly quotes etc. (API may send &#8220; or &amp;#8220;).
   * @param {string} str
   * @returns {string}
   */
  // Decode encoded HTML entities (including nested encoding).
  function vcDecodeHtmlEntities(str) {
    if (!str || typeof str !== 'string') {
      return '';
    }
    var el = document.createElement('textarea');
    var prev = '';
    var out = str;
    var i = 0;
    while (out !== prev && i < 5) {
      prev = out;
      el.innerHTML = out;
      out = el.value;
      i++;
    }
    return out;
  }

  // Reset live-search UI, timers, and in-flight requests.
  function clearLive() {
    if (debounceTimer) {
      clearTimeout(debounceTimer);
      debounceTimer = null;
    }
    if (abortController) {
      abortController.abort();
      abortController = null;
    }
    if (sugList) {
      sugList.innerHTML = '';
    }
    if (resList) {
      resList.innerHTML = '';
    }
    if (didYouMeanEl) {
      didYouMeanEl.hidden = true;
      didYouMeanEl.innerHTML = '';
    }
    if (sugWrap) {
      sugWrap.hidden = true;
    }
    if (resWrap) {
      resWrap.hidden = true;
    }
    if (loadingEl) {
      loadingEl.hidden = true;
    }
    if (allLink) {
      allLink.hidden = true;
    }
    live.hidden = true;
    if (statusEl) {
      statusEl.textContent = '';
    }
  }

  // Update SR status text for live-search feedback.
  function setStatus(msg) {
    if (statusEl) {
      statusEl.textContent = msg || '';
    }
  }

  // Render suggestions/results payload into live-search panel.
  function render(data, q) {
    var suggestions = data.suggestions || [];
    var posts = data.posts || [];

    if (sugList && sugWrap) {
      sugList.innerHTML = '';
      if (suggestions.length) {
        sugWrap.hidden = false;
        suggestions.forEach(function(item, i) {
          var li = document.createElement('li');
          li.setAttribute('role', 'option');
          li.id = 'vc-sug-' + i;
          var a = document.createElement('a');
          a.href = item.href;
          if (item.label_html) {
            a.innerHTML = item.label_html;
          } else {
            a.textContent = vcDecodeHtmlEntities(item.label);
          }
          li.appendChild(a);
          sugList.appendChild(li);
        });
      } else {
        sugWrap.hidden = true;
      }
    }

    if (resList && resWrap) {
      resList.innerHTML = '';
      if (posts.length) {
        resWrap.hidden = false;
        posts.forEach(function(p) {
          var li = document.createElement('li');
          li.setAttribute('role', 'option');
          li.className = 'vc-search-result-item';
          var a = document.createElement('a');
          a.href = p.url;
          a.className = 'vc-search-result-link';
          var img = document.createElement('img');
          img.src = p.thumb;
          img.alt = '';
          img.width = 72;
          img.height = 72;
          img.loading = 'lazy';
          var meta = document.createElement('span');
          meta.className = 'vc-search-result-meta';
          var titleEl = document.createElement('span');
          titleEl.className = 'vc-search-result-title';
          titleEl.textContent = vcDecodeHtmlEntities(p.title);
          var dateEl = document.createElement('span');
          dateEl.className = 'vc-search-result-date';
          dateEl.textContent = p.date || '';
          meta.appendChild(titleEl);
          meta.appendChild(dateEl);
          a.appendChild(img);
          a.appendChild(meta);
          li.appendChild(a);
          resList.appendChild(li);
        });
      } else {
        resWrap.hidden = true;
      }
    }

    if (didYouMeanEl) {
      if (data.did_you_mean && (!posts || !posts.length)) {
        didYouMeanEl.hidden = false;
        didYouMeanEl.innerHTML = '';
        var span = document.createElement('span');
        span.textContent = 'Did you mean ';
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'vc-search-dym-btn';
        btn.textContent = vcDecodeHtmlEntities(data.did_you_mean);
        btn.addEventListener('click', function() {
          input.value = data.did_you_mean;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        });
        didYouMeanEl.appendChild(span);
        didYouMeanEl.appendChild(btn);
        didYouMeanEl.appendChild(document.createTextNode('?'));
      } else {
        didYouMeanEl.hidden = true;
        didYouMeanEl.innerHTML = '';
      }
    }

    if (allLink && blog.vcSearchHomeUrl) {
      allLink.hidden = q.length < VC_SEARCH_MIN;
      allLink.href = blog.vcSearchHomeUrl + '?s=' + encodeURIComponent(q);
    }

    var nSug = suggestions.length;
    var nP = posts.length;
    setStatus(nP + ' article' + (nP === 1 ? '' : 's') + ', ' + nSug + ' suggestion' + (nSug === 1 ? '' : 's'));

    live.hidden = false;
    if (loadingEl) {
      loadingEl.hidden = true;
    }
  }

  input.addEventListener('input', function() {
    var q = (input.value || '').trim();
    if (q.length < VC_SEARCH_MIN) {
      clearLive();
      return;
    }
    if (debounceTimer) {
      clearTimeout(debounceTimer);
    }
    if (abortController) {
      abortController.abort();
    }
    if (loadingEl) {
      loadingEl.hidden = false;
    }
    live.hidden = false;

    debounceTimer = setTimeout(function() {
      abortController = new AbortController();
      var url =
        blog.vcSearchRestUrl +
        (blog.vcSearchRestUrl.indexOf('?') >= 0 ? '&' : '?') +
        's=' +
        encodeURIComponent(q);
      var headers = {};
      if (blog.vcSearchNonce) {
        headers['X-WP-Nonce'] = blog.vcSearchNonce;
      }
      fetch(url, {
        signal: abortController.signal,
        credentials: 'same-origin',
        headers: headers
      })
        .then(function(r) {
          if (!r.ok) {
            throw new Error('Search request failed');
          }
          return r.json();
        })
        .then(function(data) {
          render(data, q);
        })
        .catch(function(err) {
          if (err.name === 'AbortError') {
            return;
          }
          if (loadingEl) {
            loadingEl.hidden = true;
          }
          setStatus('Search could not be loaded.');
        });
    }, VC_SEARCH_DEBOUNCE_MS);
  });

  return clearLive;
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', onDOMReady);
} else {
  onDOMReady();
}


/**
 * VideoCardz Copy Protection
 * Tiered copy limits with source attribution and rate limiting.
 * Does not run for admins (body.vc-admin-mode); they can copy freely.
 * Tiers: FREE (< 80 chars) | ATTRIBUTED (80–300) | TRUNCATED (300+) | RATE_LIMITED (3+ in 30s).
 */
// Enforce tiered copy behavior for article content.
function initCopyProtection() {
  if (document.body && document.body.classList.contains('vc-admin-mode')) return;
  var article = document.getElementById('videocardz-article');
  if (!article) return;
  var CONFIG = {
    TIER_FREE: 80,
    TIER_ATTRIBUTE: 300,
    RATE_LIMIT_COUNT: 3,
    RATE_LIMIT_WINDOW: 30000,
    RATE_BLOCK_DURATION: 60000,
    SOURCE_TEXT: '\n\nSource: VideoCardz.com',
    TOAST_DURATION: 3500
  };
  var copyTimestamps = [];
  var isBlocked = false;

  // Resolve canonical URL for attribution text.
  function getArticleURL() {
    var c = document.querySelector('link[rel="canonical"]');
    return c ? c.href : window.location.href;
  }
  // Check whether current text selection is inside article.
  function isSelectionInArticle() {
    var sel = window.getSelection();
    if (!sel || sel.rangeCount === 0) return false;
    var anchor = sel.anchorNode;
    var focus = sel.focusNode;
    if (!anchor || !focus) return false;
    return article.contains(anchor) || article.contains(focus);
  }
  // Apply short-window copy rate limiting.
  function checkRateLimit() {
    if (isBlocked) return false;
    var now = Date.now();
    copyTimestamps = copyTimestamps.filter(function(t) {
      return (now - t) < CONFIG.RATE_LIMIT_WINDOW;
    });
    copyTimestamps.push(now);
    if (copyTimestamps.length > CONFIG.RATE_LIMIT_COUNT) {
      isBlocked = true;
      setTimeout(function() {
        isBlocked = false;
        copyTimestamps = [];
      }, CONFIG.RATE_BLOCK_DURATION);
      return false;
    }
    return true;
  }
  // Show transient toast message for copy feedback.
  function showToast(message, type) {
    var existing = document.getElementById('vc-copy-toast');
    if (existing) existing.remove();
    var toast = document.createElement('div');
    toast.id = 'vc-copy-toast';
    toast.className = 'vc-copy-toast';
    if (type === 'blocked') toast.classList.add('vc-copy-toast--blocked');
    if (type === 'warning') toast.classList.add('vc-copy-toast--warning');
    toast.textContent = message;
    document.body.appendChild(toast);
    requestAnimationFrame(function() { toast.classList.add('vc-copy-toast--visible'); });
    setTimeout(function() {
      toast.classList.remove('vc-copy-toast--visible');
      setTimeout(function() { if (toast.parentNode) toast.parentNode.removeChild(toast); }, 300);
    }, CONFIG.TOAST_DURATION);
  }
  // Intercept copy event and apply copy policy.
  function handleCopy(e) {
    if (!isSelectionInArticle()) return;
    var sel = window.getSelection();
    if (!sel) return;
    var text = sel.toString();
    if (!text || !text.trim()) return;
    var len = text.length;
    var url = getArticleURL();
    if (isBlocked || !checkRateLimit()) {
      e.preventDefault();
      if (e.clipboardData) e.clipboardData.setData('text/plain', '');
      showToast('Copying temporarily disabled. Please wait a moment.', 'blocked');
      return;
    }
    if (len <= CONFIG.TIER_FREE) return;
    if (len <= CONFIG.TIER_ATTRIBUTE) {
      e.preventDefault();
      if (e.clipboardData) {
        e.clipboardData.setData('text/plain', text + CONFIG.SOURCE_TEXT + '\n' + url);
      }
      return;
    }
    e.preventDefault();
    var cut = text.substring(0, CONFIG.TIER_ATTRIBUTE);
    var space = cut.lastIndexOf(' ');
    if (space > CONFIG.TIER_ATTRIBUTE * 0.8) cut = cut.substring(0, space);
    if (e.clipboardData) {
      e.clipboardData.setData('text/plain', cut + '...' + CONFIG.SOURCE_TEXT + '\n' + url);
    }
    showToast('Content trimmed. Full article available at VideoCardz.com', 'warning');
  }
  document.addEventListener('copy', handleCopy, true);
}

/**
 * VC Modern Gallery - Optimized
 * Handles gallery shortcode with touch support, fullscreen, and performance enhancements
 */
// Initialize modern gallery used in article pages.
function initVCGallery() {
  const galleries = document.querySelectorAll('.vc-gallery-container');
  
  // Check for reduced motion preference
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const transitionDuration = prefersReducedMotion ? 0 : 250;
  
  galleries.forEach(gallery => {
    const ac = new AbortController();
    const sig = { signal: ac.signal };
    const sigPassive = { passive: true, signal: ac.signal };
    // Cache DOM elements
    const main = gallery.querySelector('.vc-gallery-main');
    const background = gallery.querySelector('.vc-gallery-background');
    const slideContainer = gallery.querySelector('.vc-gallery-slide-container');
    const slideImg = gallery.querySelector('.vc-gallery-slide-img');
    const currentCounter = gallery.querySelector('.vc-gallery-counter .vc-gallery-current');
    const prevBtn = gallery.querySelector('.vc-gallery-prev');
    const nextBtn = gallery.querySelector('.vc-gallery-next');
    const fullscreenBtn = gallery.querySelector('.vc-gallery-fullscreen');
    const thumbnails = gallery.querySelectorAll('.vc-gallery-thumb');
    const thumbStrip = gallery.querySelector('.vc-gallery-thumbnails');
    
    // Fullscreen elements
    const fsModal = gallery.querySelector('.vc-gallery-fullscreen-modal');
    const fsBackdrop = gallery.querySelector('.vc-gallery-fullscreen-backdrop');
    const fsMain = gallery.querySelector('.vc-gallery-fullscreen-main');
    const fsBackground = gallery.querySelector('.vc-gallery-fullscreen-background');
    const fsImg = gallery.querySelector('.vc-gallery-fullscreen-img');
    const fsCounter = fsModal.querySelector('.vc-gallery-fullscreen-counter .vc-gallery-current');
    const fsClose = gallery.querySelector('.vc-gallery-fullscreen-close');
    const fsPrev = gallery.querySelector('.vc-gallery-fullscreen-prev');
    const fsNext = gallery.querySelector('.vc-gallery-fullscreen-next');
    
    // State management
    let currentIndex = 0;
    let touchStartX = 0;
    let touchEndX = 0;
    let isDragging = false;
    let isAnimating = false;
    let isInitialized = false;
    let observer = null;
    
    // Image cache for preloading
    const imageCache = new Map();
    
    /**
     * Preload gallery images for smooth transitions
     * Prioritizes: current image, adjacent images, then rest
     */
    // Preload current/adjacent gallery images for smoother swaps.
    function preloadImages() {
      if (thumbnails.length === 0) return;
      
      // Create array of indices in priority order
      const indices = [currentIndex]; // Current first
      
      // Add adjacent images
      const prevIndex = currentIndex - 1 >= 0 ? currentIndex - 1 : thumbnails.length - 1;
      const nextIndex = currentIndex + 1 < thumbnails.length ? currentIndex + 1 : 0;
      indices.push(nextIndex, prevIndex);
      
      // Add remaining images
      for (let i = 0; i < thumbnails.length; i++) {
        if (!indices.includes(i)) {
          indices.push(i);
        }
      }
      
      // Preload in priority order
      indices.forEach((index, priority) => {
        const thumb = thumbnails[index];
        if (!thumb) return;
        
        const fullUrl = thumb.dataset.full;
        if (!fullUrl || imageCache.has(fullUrl)) return;
        
        const img = new Image();
        img.src = fullUrl;
        imageCache.set(fullUrl, img);
        
        // Mark as loaded when ready
        img.onload = () => {
          thumb.dataset.preloaded = 'true';
        };
      });
    }
    
    /**
     * Initialize gallery (called when gallery enters viewport)
     */
    // Lazily initialize gallery once it enters viewport.
    function initializeGallery() {
      if (isInitialized) return;
      isInitialized = true;
      
      // Preload images
      preloadImages();
      
      // Set initial state
      goToSlide(0);
    }
    
    // Update slide with optimizations
    // Navigate to a target gallery slide with transition updates.
    function goToSlide(index) {
      // Prevent concurrent animations
      if (isAnimating) return;
      
      // Validate and wrap index
      if (index < 0) index = thumbnails.length - 1;
      if (index >= thumbnails.length) index = 0;
      if (index === currentIndex && isInitialized) return;
      
      isAnimating = true;
      const previousIndex = currentIndex;
      currentIndex = index;
      
      const thumb = thumbnails[index];
      if (!thumb) {
        isAnimating = false;
        return;
      }
      
      const fullUrl = thumb.dataset.full;
      if (!fullUrl) {
        isAnimating = false;
        return;
      }
      
      // Preload adjacent images for next transition
      const nextIndex = (index + 1) % thumbnails.length;
      const prevIndex = (index - 1 + thumbnails.length) % thumbnails.length;
      [nextIndex, prevIndex].forEach(i => {
        const url = thumbnails[i]?.dataset.full;
        if (url && !imageCache.has(url)) {
          const img = new Image();
          img.src = url;
          imageCache.set(url, img);
        }
      });
      
      // Fade out current image (respects reduced motion)
      if (!prefersReducedMotion) {
        slideImg.style.opacity = '0';
        if (fsModal.classList.contains('active')) {
          fsImg.style.opacity = '0';
        }
      }
      
      setTimeout(() => {
        // Update images and background
        slideImg.src = fullUrl;
        background.style.backgroundImage = `url(${fullUrl})`;
        
        if (fsModal.classList.contains('active')) {
          fsImg.src = fullUrl;
          fsBackground.style.backgroundImage = `url(${fullUrl})`;
        }
        
        // Update ARIA attributes
        slideImg.setAttribute('aria-label', `Image ${index + 1} of ${thumbnails.length}`);
        if (fsImg) {
          fsImg.setAttribute('aria-label', `Image ${index + 1} of ${thumbnails.length}`);
        }
        
        // Fade in new image
        requestAnimationFrame(() => {
          if (!prefersReducedMotion) {
            slideImg.style.opacity = '1';
            if (fsModal.classList.contains('active')) {
              fsImg.style.opacity = '1';
            }
          }
        });
        
        setTimeout(() => {
          isAnimating = false;
        }, transitionDuration);
      }, transitionDuration);
      
      // Update counters
      if (currentCounter) currentCounter.textContent = index + 1;
      if (fsCounter) fsCounter.textContent = index + 1;
      
      // Update thumbnails with ARIA
      thumbnails.forEach((t, i) => {
        const isActive = i === index;
        t.classList.toggle('active', isActive);
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        t.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
      
      // Scroll thumbnail into view inside the strip only (avoid moving the page)
      if (thumbStrip && thumb) {
        const scrollLeft = thumb.offsetLeft - (thumbStrip.offsetWidth / 2) + (thumb.offsetWidth / 2);
        thumbStrip.scrollTo({
          left: Math.max(0, scrollLeft),
          behavior: prefersReducedMotion ? 'auto' : 'smooth'
        });
      }
    }
    
    // Navigation
    prevBtn.addEventListener('click', () => goToSlide(currentIndex - 1), sig);
    nextBtn.addEventListener('click', () => goToSlide(currentIndex + 1), sig);
    fsPrev.addEventListener('click', () => goToSlide(currentIndex - 1), sig);
    fsNext.addEventListener('click', () => goToSlide(currentIndex + 1), sig);
    
    // Thumbnail clicks
    thumbnails.forEach((thumb, index) => {
      thumb.addEventListener('click', () => goToSlide(index), sig);
    });
    
    // Touch/swipe support for main gallery
    main.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      isDragging = true;
    }, sigPassive);
    
    main.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      touchEndX = e.changedTouches[0].screenX;
    }, sigPassive);
    
    main.addEventListener('touchend', () => {
      if (!isDragging) return;
      isDragging = false;
      
      const diff = touchStartX - touchEndX;
      const threshold = 50;
      
      if (Math.abs(diff) > threshold) {
        if (diff > 0) {
          goToSlide(currentIndex + 1);
        } else {
          goToSlide(currentIndex - 1);
        }
      }
    }, sigPassive);
    
    // Touch/swipe support for fullscreen
    fsMain.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      isDragging = true;
    }, sigPassive);
    
    fsMain.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      touchEndX = e.changedTouches[0].screenX;
    }, sigPassive);
    
    fsMain.addEventListener('touchend', () => {
      if (!isDragging) return;
      isDragging = false;
      
      const diff = touchStartX - touchEndX;
      const threshold = 50;
      
      if (Math.abs(diff) > threshold) {
        if (diff > 0) {
          goToSlide(currentIndex + 1);
        } else {
          goToSlide(currentIndex - 1);
        }
      }
    }, sigPassive);
    
    // Keyboard navigation (separate handler for gallery controls)
    // Handle keyboard controls while fullscreen is active.
    function handleGalleryKeyboard(e) {
      if (!fsModal.classList.contains('active')) return;
      
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goToSlide(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        goToSlide(currentIndex + 1);
      } else if (e.key === 'Escape') {
        closeFullscreen();
      }
    }
    document.addEventListener('keydown', handleGalleryKeyboard, sig);
    
    // Prevent image copying in fullscreen
    // Block context menu/drag actions for fullscreen image.
    function preventImageCopy(e) {
      e.preventDefault();
      e.stopPropagation();
      return false;
    }
    // Block common keyboard copy/save shortcuts in fullscreen.
    function preventKeyboardCopy(e) {
      if (fsModal.classList.contains('active')) {
        // Block common copy shortcuts
        if ((e.ctrlKey || e.metaKey) && (e.key === 'c' || e.key === 'C' || e.key === 'a' || e.key === 'A' || e.key === 's' || e.key === 'S')) {
          e.preventDefault();
          e.stopPropagation();
          return false;
        }
        // Block Print Screen (F12)
        if (e.key === 'PrintScreen' || e.keyCode === 44) {
          e.preventDefault();
          return false;
        }
      }
    }
    
    // Fullscreen
    // Enter fullscreen mode and attach protection listeners.
    function openFullscreen() {
      fsModal.classList.add('active');
      document.body.style.overflow = 'hidden';
      
      // Sync current image
      const fullUrl = thumbnails[currentIndex].dataset.full;
      fsImg.src = fullUrl;
      fsBackground.style.backgroundImage = `url(${fullUrl})`;
      
      // Add protection event listeners
      fsModal.addEventListener('contextmenu', preventImageCopy);
      fsModal.addEventListener('dragstart', preventImageCopy);
      fsImg.addEventListener('contextmenu', preventImageCopy);
      fsImg.addEventListener('dragstart', preventImageCopy);
      fsMain.addEventListener('contextmenu', preventImageCopy);
      fsMain.addEventListener('dragstart', preventImageCopy);
      document.addEventListener('keydown', preventKeyboardCopy);
      // Note: handleGalleryKeyboard is already added as document listener above, no need to add again
    }
    
    // Exit fullscreen mode and detach protection listeners.
    function closeFullscreen() {
      fsModal.classList.remove('active');
      document.body.style.overflow = '';
      
      // Remove protection event listeners
      fsModal.removeEventListener('contextmenu', preventImageCopy);
      fsModal.removeEventListener('dragstart', preventImageCopy);
      fsImg.removeEventListener('contextmenu', preventImageCopy);
      fsImg.removeEventListener('dragstart', preventImageCopy);
      fsMain.removeEventListener('contextmenu', preventImageCopy);
      fsMain.removeEventListener('dragstart', preventImageCopy);
      document.removeEventListener('keydown', preventKeyboardCopy);
      // Note: handleGalleryKeyboard stays as document listener (checks modal.active internally)
    }
    
    fullscreenBtn.addEventListener('click', openFullscreen, sig);
    fsClose.addEventListener('click', closeFullscreen, sig);
    
    // Click on carousel image or container opens fullscreen
    slideImg.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      openFullscreen();
    }, sig);
    slideContainer.addEventListener('click', (e) => {
      if (e.target === slideContainer || e.target === slideImg) {
        e.preventDefault();
        e.stopPropagation();
        openFullscreen();
      }
    }, sig);
    
    // Click outside image (backdrop or blurred background) closes fullscreen
    fsModal.addEventListener('click', (e) => {
      if (e.target.closest('.vc-gallery-fullscreen-img') || e.target.closest('button')) return;
      closeFullscreen();
    }, sig);
    
    // Intersection Observer for lazy initialization
    // Only initialize gallery when it enters viewport
    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !isInitialized) {
            initializeGallery();
            // Once initialized, we can unobserve
            if (observer) {
              observer.unobserve(gallery);
            }
          }
        });
      }, { 
        rootMargin: '50px', // Start loading slightly before entering viewport
        threshold: 0.1 
      });
      
      observer.observe(gallery);
    } else {
      // Fallback: initialize immediately if Intersection Observer not supported
      initializeGallery();
    }
    
    // Cleanup: remove all listeners and release refs (prevents detached DOM on navigate/replace)
    gallery.vcGalleryCleanup = function() {
      ac.abort();
      if (observer) {
        observer.disconnect();
        observer = null;
      }
      imageCache.clear();
      isInitialized = false;
    };
  });

  window.addEventListener('pagehide', function() {
    document.querySelectorAll('.vc-gallery-container').forEach(function(g) {
      if (g.vcGalleryCleanup) g.vcGalleryCleanup();
    });
  });
}

/**
 * VCN Gallery - Database (card/GPU templates)
 * Same behavior as VC gallery but for .vcn-gallery-container
 */
// Initialize gallery used in database card/GPU templates.
function initVCNGallery() {
  const galleries = document.querySelectorAll('.vcn-gallery-container');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const transitionDuration = prefersReducedMotion ? 0 : 250;

  galleries.forEach(gallery => {
    const ac = new AbortController();
    const sig = { signal: ac.signal };
    const sigPassive = { passive: true, signal: ac.signal };

    const main = gallery.querySelector('.vcn-gallery-main');
    const background = gallery.querySelector('.vcn-gallery-background');
    const slideImg = gallery.querySelector('.vcn-gallery-slide-img');
    const currentCounter = gallery.querySelector('.vcn-gallery-counter .vcn-gallery-current');
    const prevBtn = gallery.querySelector('.vcn-gallery-prev');
    const nextBtn = gallery.querySelector('.vcn-gallery-next');
    const fullscreenBtn = gallery.querySelector('.vcn-gallery-fullscreen');
    const downloadCurrentBtn = gallery.querySelector('.vcn-gallery-download-current');
    const downloadAllBtn = gallery.querySelector('.vcn-gallery-download-all');
    const thumbnails = gallery.querySelectorAll('.vcn-gallery-thumb');
    const thumbStrip = gallery.querySelector('.vcn-gallery-thumbnails');
    const fsModal = gallery.querySelector('.vcn-gallery-fullscreen-modal');
    const fsBackdrop = gallery.querySelector('.vcn-gallery-fullscreen-backdrop');
    const fsMain = gallery.querySelector('.vcn-gallery-fullscreen-main');
    const fsBackground = gallery.querySelector('.vcn-gallery-fullscreen-background');
    const fsImg = gallery.querySelector('.vcn-gallery-fullscreen-img');
    const fsCounter = fsModal ? fsModal.querySelector('.vcn-gallery-fullscreen-counter .vcn-gallery-current') : null;
    const fsClose = gallery.querySelector('.vcn-gallery-fullscreen-close');
    const fsPrev = gallery.querySelector('.vcn-gallery-fullscreen-prev');
    const fsNext = gallery.querySelector('.vcn-gallery-fullscreen-next');

    if (!main || !slideImg || !fsModal) return;

    // Prevent image from being opened directly (right-click, drag, etc.)
    // Prevent direct open/copy interactions on database images.
    function preventImageOpen(e) {
      e.preventDefault();
      e.stopPropagation();
      return false;
    }
    slideImg.addEventListener('contextmenu', preventImageOpen, sig);
    slideImg.addEventListener('dragstart', preventImageOpen, sig);
    slideImg.addEventListener('selectstart', preventImageOpen, sig);
    
    // Make clicking the main image open fullscreen instead
    slideImg.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (fullscreenBtn) fullscreenBtn.click();
    }, sig);
    // Make the slide container clickable to open fullscreen (image has pointer-events: none)
    const slideContainer = gallery.querySelector('.vcn-gallery-slide-container');
    if (slideContainer) {
      slideContainer.addEventListener('click', (e) => {
        // Only trigger if clicking the container itself (not buttons/controls)
        if (e.target === slideContainer || e.target === slideImg) {
          e.preventDefault();
          e.stopPropagation();
          if (fullscreenBtn) fullscreenBtn.click();
        }
      }, sig);
    }

    let currentIndex = 0;
    let touchStartX = 0;
    let touchEndX = 0;
    let isDragging = false;
    let isAnimating = false;
    let isInitialized = false;
    let observer = null;
    const imageCache = new Map();

    // Navigate VCN gallery to selected slide index.
    function goToSlide(index) {
      if (isAnimating) return;
      if (index < 0) index = thumbnails.length - 1;
      if (index >= thumbnails.length) index = 0;
      if (index === currentIndex && isInitialized) return;
      isAnimating = true;
      currentIndex = index;
      const thumb = thumbnails[index];
      if (!thumb) { isAnimating = false; return; }
      const fullUrl = thumb.dataset.full;
      if (!fullUrl) { isAnimating = false; return; }

      const nextIndex = (index + 1) % thumbnails.length;
      const prevIndex = (index - 1 + thumbnails.length) % thumbnails.length;
      [nextIndex, prevIndex].forEach(i => {
        const url = thumbnails[i]?.dataset.full;
        if (url && !imageCache.has(url)) { const img = new Image(); img.src = url; imageCache.set(url, img); }
      });

      if (!prefersReducedMotion) {
        slideImg.style.opacity = '0';
        if (fsModal.classList.contains('active')) fsImg.style.opacity = '0';
      }
      setTimeout(() => {
        slideImg.src = fullUrl;
        background.style.backgroundImage = `url(${fullUrl})`;
        if (fsModal.classList.contains('active')) {
          fsImg.src = fullUrl;
          fsBackground.style.backgroundImage = `url(${fullUrl})`;
        }
        requestAnimationFrame(() => {
          if (!prefersReducedMotion) {
            slideImg.style.opacity = '1';
            if (fsModal.classList.contains('active')) fsImg.style.opacity = '1';
          }
        });
        setTimeout(() => { isAnimating = false; }, transitionDuration);
      }, transitionDuration);

      if (currentCounter) currentCounter.textContent = index + 1;
      if (fsCounter) fsCounter.textContent = index + 1;
      thumbnails.forEach((t, i) => {
        const isActive = i === index;
        t.classList.toggle('active', isActive);
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        t.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
      // Scroll thumbnail into view inside the strip only (avoid moving the page)
      if (thumbStrip && thumb) {
        const scrollLeft = thumb.offsetLeft - (thumbStrip.offsetWidth / 2) + (thumb.offsetWidth / 2);
        thumbStrip.scrollTo({
          left: Math.max(0, scrollLeft),
          behavior: prefersReducedMotion ? 'auto' : 'smooth'
        });
      }
    }

    prevBtn && prevBtn.addEventListener('click', () => goToSlide(currentIndex - 1), sig);
    nextBtn && nextBtn.addEventListener('click', () => goToSlide(currentIndex + 1), sig);
    fsPrev && fsPrev.addEventListener('click', () => goToSlide(currentIndex - 1), sig);
    fsNext && fsNext.addEventListener('click', () => goToSlide(currentIndex + 1), sig);
    thumbnails.forEach((thumb, index) => { thumb.addEventListener('click', () => goToSlide(index), sig); });

    // Admin: download current image or all images (high-res with watermarks).
    const safeFileName = (s) => (s || 'image').replace(/[^\w\s.-]/g, '').replace(/\s+/g, '-').slice(0, 80) || 'image';
    // Parse download URL metadata attached to admin buttons.
    function getDownloadList(btn) {
      if (!btn || !btn.dataset.downloadUrls) return null;
      try {
        const list = JSON.parse(btn.dataset.downloadUrls);
        return Array.isArray(list) ? list : null;
      } catch (e) {
        return null;
      }
    }
    if (downloadCurrentBtn && getDownloadList(downloadCurrentBtn)) {
      downloadCurrentBtn.addEventListener('click', async () => {
        const list = getDownloadList(downloadCurrentBtn);
        if (!list || list.length === 0) return;
        const { url, name } = list[currentIndex] || list[0];
        const base = safeFileName(name) + '-' + (currentIndex + 1);
        const fileName = base + (url.toLowerCase().endsWith('.png') ? '.png' : '.jpg');
        const src = slideImg.src || url;
        downloadCurrentBtn.disabled = true;
        downloadCurrentBtn.setAttribute('aria-busy', 'true');
        try {
          const res = await fetch(src, { mode: 'cors' });
          if (!res.ok) return;
          const blob = await res.blob();
          const blobUrl = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = blobUrl;
          a.download = fileName;
          a.rel = 'noopener';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(blobUrl);
        } catch (err) {
          console.warn('VCN gallery download current:', fileName, err);
        }
        downloadCurrentBtn.disabled = false;
        downloadCurrentBtn.removeAttribute('aria-busy');
      }, sig);
    }
    if (downloadAllBtn && getDownloadList(downloadAllBtn)) {
      downloadAllBtn.addEventListener('click', async () => {
        const list = getDownloadList(downloadAllBtn);
        if (!list || list.length === 0) return;
        downloadAllBtn.disabled = true;
        downloadAllBtn.setAttribute('aria-busy', 'true');
        for (let i = 0; i < list.length; i++) {
          const { url, name } = list[i];
          const base = safeFileName(name) + '-' + (i + 1);
          const fileName = base + (url.toLowerCase().endsWith('.png') ? '.png' : '.jpg');
          try {
            const res = await fetch(url, { mode: 'cors' });
            if (!res.ok) continue;
            const blob = await res.blob();
            const blobUrl = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = blobUrl;
            a.download = fileName;
            a.rel = 'noopener';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(blobUrl);
          } catch (err) {
            console.warn('VCN gallery download:', fileName, err);
          }
          await new Promise(r => setTimeout(r, 250));
        }
        downloadAllBtn.disabled = false;
        downloadAllBtn.removeAttribute('aria-busy');
      }, sig);
    }

    main.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].screenX; isDragging = true; }, sigPassive);
    main.addEventListener('touchmove', (e) => { if (isDragging) touchEndX = e.changedTouches[0].screenX; }, sigPassive);
    main.addEventListener('touchend', () => {
      if (!isDragging) return;
      isDragging = false;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) goToSlide(diff > 0 ? currentIndex + 1 : currentIndex - 1);
    }, sigPassive);

    fsMain.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].screenX; isDragging = true; }, sigPassive);
    fsMain.addEventListener('touchmove', (e) => { if (isDragging) touchEndX = e.changedTouches[0].screenX; }, sigPassive);
    fsMain.addEventListener('touchend', () => {
      if (!isDragging) return;
      isDragging = false;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) goToSlide(diff > 0 ? currentIndex + 1 : currentIndex - 1);
    }, sigPassive);

    // Keyboard navigation (separate handler for gallery controls)
    // Handle keyboard navigation for VCN fullscreen gallery.
    function handleGalleryKeyboard(e) {
      if (!fsModal.classList.contains('active')) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); goToSlide(currentIndex - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); goToSlide(currentIndex + 1); }
      else if (e.key === 'Escape') closeFullscreen();
    }
    document.addEventListener('keydown', handleGalleryKeyboard, sig);

    // Prevent image copying in fullscreen
    // Block context menu/drag in VCN fullscreen mode.
    function preventImageCopy(e) {
      e.preventDefault();
      e.stopPropagation();
      return false;
    }
    // Block keyboard copy/save shortcuts in VCN fullscreen mode.
    function preventKeyboardCopy(e) {
      if (fsModal.classList.contains('active')) {
        // Block common copy shortcuts
        if ((e.ctrlKey || e.metaKey) && (e.key === 'c' || e.key === 'C' || e.key === 'a' || e.key === 'A' || e.key === 's' || e.key === 'S')) {
          e.preventDefault();
          e.stopPropagation();
          return false;
        }
        // Block Print Screen (F12)
        if (e.key === 'PrintScreen' || e.keyCode === 44) {
          e.preventDefault();
          return false;
        }
      }
    }
    
    // Open VCN fullscreen gallery and attach guards.
    function openFullscreen() {
      fsModal.classList.add('active');
      document.body.style.overflow = 'hidden';
      const fullUrl = thumbnails[currentIndex].dataset.full;
      fsImg.src = fullUrl;
      fsBackground.style.backgroundImage = `url(${fullUrl})`;
      
      // Add protection event listeners
      fsModal.addEventListener('contextmenu', preventImageCopy);
      fsModal.addEventListener('dragstart', preventImageCopy);
      fsImg.addEventListener('contextmenu', preventImageCopy);
      fsImg.addEventListener('dragstart', preventImageCopy);
      fsMain.addEventListener('contextmenu', preventImageCopy);
      fsMain.addEventListener('dragstart', preventImageCopy);
      document.addEventListener('keydown', preventKeyboardCopy);
      document.addEventListener('keydown', handleGalleryKeyboard);
    }
    // Close VCN fullscreen gallery and detach guards.
    function closeFullscreen() {
      fsModal.classList.remove('active');
      document.body.style.overflow = '';
      
      // Remove protection event listeners
      fsModal.removeEventListener('contextmenu', preventImageCopy);
      fsModal.removeEventListener('dragstart', preventImageCopy);
      fsImg.removeEventListener('contextmenu', preventImageCopy);
      fsImg.removeEventListener('dragstart', preventImageCopy);
      fsMain.removeEventListener('contextmenu', preventImageCopy);
      fsMain.removeEventListener('dragstart', preventImageCopy);
      document.removeEventListener('keydown', preventKeyboardCopy);
    }
    fullscreenBtn && fullscreenBtn.addEventListener('click', openFullscreen, sig);
    fsClose && fsClose.addEventListener('click', closeFullscreen, sig);
    // Click outside image (backdrop or blurred background) closes fullscreen
    fsModal.addEventListener('click', (e) => {
      if (e.target.closest('.vcn-gallery-fullscreen-img') || e.target.closest('button')) return;
      closeFullscreen();
    }, sig);

    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !isInitialized) {
            isInitialized = true;
            goToSlide(0);
            if (observer) observer.unobserve(gallery);
          }
        });
      }, { rootMargin: '50px', threshold: 0.1 });
      observer.observe(gallery);
    } else {
      isInitialized = true;
      goToSlide(0);
    }

    gallery.vcnGalleryCleanup = function() {
      ac.abort();
      if (observer) {
        observer.disconnect();
        observer = null;
      }
      imageCache.clear();
      isInitialized = false;
    };
  });

  window.addEventListener('pagehide', function() {
    document.querySelectorAll('.vcn-gallery-container').forEach(function(g) {
      if (g.vcnGalleryCleanup) g.vcnGalleryCleanup();
    });
  });
}

/**
 * VideoCardz Database YouTube Video Integration
 * Handles video items and inline player embedding within video section
 */
// Initialize inline YouTube player behavior for DB videos.
function initDatabaseVideos() {
  const videoThumbnails = document.querySelectorAll('.db-video-thumbnail');

  if (videoThumbnails.length === 0) {
    return;
  }

  videoThumbnails.forEach(function(thumbnail) {
    thumbnail.addEventListener('click', function(event) {
      event.preventDefault();
      event.stopPropagation();
      
      const videoId = this.dataset.videoId;
      const videoTitle = this.dataset.videoTitle || 'YouTube Video';
      
      if (!videoId) return;
      
      const playerContainer = document.querySelector('.db-video-player-container');
      
      if (!playerContainer) {
        return;
      }
      
      const iframe = playerContainer.querySelector('iframe');
      const titleElement = playerContainer.querySelector('.db-video-current-title');
      const closeBtn = playerContainer.querySelector('.db-video-close-btn');
      
      titleElement.textContent = videoTitle;
      iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
      playerContainer.style.display = 'block';
      
      playerContainer.scrollIntoView({ 
        behavior: 'smooth', 
        block: 'start' 
      });
      
      if (!closeBtn.hasAttribute('data-listener-added')) {
        closeBtn.addEventListener('click', function() {
          iframe.src = '';
          playerContainer.style.display = 'none';
        });
        closeBtn.setAttribute('data-listener-added', 'true');
      }
    });
  });
}


/**
 * Initialize global Disqus count script functionality
 * This handles the global Disqus count script loading and processing
 */
// Initialize lazy loading of Disqus comment counts.
function initDisqusCountGlobalScript() {
  // Initialize if not already done
  if (typeof window.disqusCountLoaded !== 'undefined') return;
  window.disqusCountLoaded = true;
  
  // Function to load Disqus count
  // Trigger Disqus count script load for one target element.
  function loadDisqusCount(identifier, url, elementId) {
    var element = document.getElementById(elementId);
    if (!element || element.dataset.loaded === "true") return;
    
    element.dataset.loaded = "true";
    
    // Fetch comment count via Disqus API
    var script = document.createElement("script");
    script.src = "https://videocardz.disqus.com/count.js";
    script.async = true;
    document.head.appendChild(script);
  }
  
  // Process all disqus count elements
  // Observe and process all queued Disqus count elements.
  function processDisqusElements() {
    if (typeof window.disqusCountElements === 'undefined') return;
    
    // Use Intersection Observer to lazy load the counts
    if ("IntersectionObserver" in window) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var elementId = entry.target.id;
            var elementData = window.disqusCountElements.find(function(item) {
              return item.id === elementId;
            });
            if (elementData) {
              loadDisqusCount(elementData.identifier, elementData.url, elementData.id);
            }
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: "50px" });
      
      // Observe all disqus count elements
      window.disqusCountElements.forEach(function(item) {
        var element = document.getElementById(item.id);
        if (element) {
          observer.observe(element);
        }
      });
    } else {
      // Fallback for older browsers - load all immediately
      window.disqusCountElements.forEach(function(item) {
        loadDisqusCount(item.identifier, item.url, item.id);
      });
    }
  }
  
  // Make processDisqusElements globally available for AJAX load more functionality
  window.processDisqusElements = processDisqusElements;
  
  // Run when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', processDisqusElements);
  } else {
    processDisqusElements();
  }
}

/**
 * Initialize load more functionality
 * Handles AJAX loading of additional posts for both main content and techbuzz
 */
// Initialize AJAX "load more" behavior for main and timeline lists.
function initLoadMore() {
  // Only initialize if jQuery is available
  if (typeof jQuery === 'undefined') {
    console.log('jQuery not available, skipping load more initialization');
    return;
  }
  
  var $ = jQuery;
  var page_main = 2;
  var page_techbuzz = 2;
  var clickCountMain = 0;
  var clickCountTechBuzz = 0;
  var maxNumberOfClicks = 10;
  
  // Main load more functionality (delegation avoids holding refs to buttons - prevents detached DOM)
  $(document).on('click', '#vc-load-more-button-main', function() {
    if (clickCountMain < maxNumberOfClicks) {
      var data = {
        'action': 'loadmore_main',
        'page_main': page_main,
        'security_main': blog.security_main
      };

      $.post(blog.ajaxurl, data, function(response) {
        if ($.trim(response) != '') {
          $('#vc-maincontainer-inner-storycontainer-index').append(response);
          page_main++;
          
          // Trigger Disqus count processing for newly loaded posts
          try {
            setTimeout(function() {
              if (typeof window.processDisqusElements === 'function') {
                window.processDisqusElements();
              } else if (typeof window.DISQUSWIDGETS !== 'undefined') {
                // Fallback: trigger Disqus widgets to process new elements
                window.DISQUSWIDGETS.getCount({reset: true});
              } else {
                // Additional fallback: reload the Disqus count script
                var script = document.createElement('script');
                script.src = 'https://videocardz.disqus.com/count.js';
                script.async = true;
                script.setAttribute('data-timestamp', +new Date());
                document.head.appendChild(script);
              }
            }, 500);
          } catch (e) {
            // If Disqus processing fails, continue anyway
            console.log('Disqus processing failed:', e);
          }
        } else {
          $('#vc-load-more-button-main').hide();
        }
      }).fail(function() {
        // Handle AJAX errors
        console.log('Load more request failed');
      });

      // Increment the click count
      clickCountMain++;
      if (clickCountMain == maxNumberOfClicks)
        $('#vc-load-more-button-main').hide();
    } else {
      $('#vc-load-more-button-main').hide();
    }
  });
  
  // Techbuzz load more functionality (delegation avoids holding refs to buttons - prevents detached DOM)
  $(document).on('click', '#vc-load-more-button-techbuzz', function() {
    if (clickCountTechBuzz < maxNumberOfClicks) {
      // Store the last techbuzz entry before loading new content
      var lastTechbuzzEntry = $('#techbuzz .techbuzz-entry').last();
      var scrollTarget = lastTechbuzzEntry.length ? lastTechbuzzEntry[0] : null;
      
      var data = {
        'action': 'loadmore_techbuzz',
        'page_techbuzz': page_techbuzz,
        'security_buzz': blog.security_buzz
      };

      $.post(blog.ajaxurl, data, function(response) {
        if ($.trim(response) != '') {
          $('#techbuzz').append(response);
          page_techbuzz++;
          
          // Scroll to the last item that was visible before loading new content
          if (scrollTarget) {
            setTimeout(function() {
              scrollTarget.scrollIntoView({ 
                behavior: 'smooth', 
                block: 'start' 
              });
            }, 100);
          }
          
          // Trigger Disqus count processing for newly loaded posts
          try {
            setTimeout(function() {
              if (typeof window.processDisqusElements === 'function') {
                window.processDisqusElements();
              } else if (typeof window.DISQUSWIDGETS !== 'undefined') {
                // Fallback: trigger Disqus widgets to process new elements
                window.DISQUSWIDGETS.getCount({reset: true});
              } else {
                // Additional fallback: reload the Disqus count script
                var script = document.createElement('script');
                script.src = 'https://videocardz.disqus.com/count.js';
                script.async = true;
                script.setAttribute('data-timestamp', +new Date());
                document.head.appendChild(script);
              }
            }, 500);
          } catch (e) {
            // If Disqus processing fails, continue anyway
            console.log('Disqus processing failed:', e);
          }
        } else {
          $('#vc-load-more-button-techbuzz').hide();
        }
      }).fail(function() {
        // Handle AJAX errors
        console.log('Load more request failed');
      });

      // Increment the click count
      clickCountTechBuzz++;
      if (clickCountTechBuzz == maxNumberOfClicks)
        $('#vc-load-more-button-techbuzz').hide();
    } else {
      $('#vc-load-more-button-techbuzz').hide();
    }
  });
}

// ========================================
// Popular News Header Slider
// ========================================
(function() {
  'use strict';

  // Initialize top "Popular News" carousel interactions.
  function initPopularNewsSlider() {
    const slider = document.querySelector('.popular-news-slider');
    if (!slider) return;

    const slides = document.querySelectorAll('.popular-news-slide');
    const totalSlides = slides.length;
    if (totalSlides <= 1) return;

    let currentSlide = 0;
    let slideTimeout;
    let pauseTime = 0;
    let remainingTime = 5000;
    const SLIDE_DURATION = 5000;
    let isVisible = false;
    let isHovered = false;
    let observer = null;
    let touchStartX = 0;
    let touchEndX = 0;

    // Preload slider background images for faster transitions.
    function preloadSlideImages() {
      slides.forEach(function(slide) {
        const bg = slide.querySelector('.featured-story-popular');
        if (bg) {
          const bgImage = window.getComputedStyle(bg).backgroundImage;
          const urlMatch = bgImage.match(/url\(['"]?([^'"]+)['"]?\)/);
          if (urlMatch && urlMatch[1]) {
            const img = new Image();
            img.src = urlMatch[1];
          }
        }
      });
    }

    // Activate a specific slider slide and matching dot.
    function popularNewsGoToSlide(slideIndex) {
      if (slideIndex < 0 || slideIndex >= totalSlides) return;
      const currentSlideEl = document.querySelector('.popular-news-slide.active');
      const currentDot = document.querySelector('.popular-news-dot.active');
      const newSlide = document.querySelector('.popular-news-slide[data-slide="' + slideIndex + '"]');
      const allDots = document.querySelectorAll('.popular-news-dot');
      const newDot = allDots[slideIndex];
      if (!newSlide) return;
      if (currentSlideEl) {
        currentSlideEl.classList.remove('active');
        currentSlideEl.setAttribute('aria-hidden', 'true');
      }
      if (currentDot) {
        currentDot.classList.remove('active');
        currentDot.setAttribute('aria-selected', 'false');
      }
      newSlide.classList.add('active');
      newSlide.setAttribute('aria-hidden', 'false');
      if (newDot) {
        newDot.classList.add('active');
        newDot.setAttribute('aria-selected', 'true');
      }
      currentSlide = slideIndex;
      if (isVisible && !isHovered) startSlideTimer();
    }

    // Advance carousel to the next slide.
    function popularNewsNext() {
      popularNewsGoToSlide((currentSlide + 1) % totalSlides);
    }

    // Move carousel to the previous slide.
    function popularNewsPrevious() {
      popularNewsGoToSlide((currentSlide - 1 + totalSlides) % totalSlides);
    }

    // Start autoplay timer from full slide duration.
    function startSlideTimer() {
      clearTimeout(slideTimeout);
      remainingTime = SLIDE_DURATION;
      pauseTime = Date.now();
      slideTimeout = setTimeout(popularNewsNext, SLIDE_DURATION);
    }

    // Pause autoplay timer and preserve remaining time.
    function pauseSlideTimer() {
      clearTimeout(slideTimeout);
      var elapsed = Date.now() - pauseTime;
      remainingTime = Math.max(0, remainingTime - elapsed);
    }

    // Resume autoplay timer using remaining duration.
    function resumeSlideTimer() {
      clearTimeout(slideTimeout);
      pauseTime = Date.now();
      slideTimeout = setTimeout(popularNewsNext, remainingTime);
    }

    // Convert horizontal swipe gestures into slide navigation.
    function handleSwipe() {
      var swipeThreshold = 50;
      var diff = touchStartX - touchEndX;
      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) popularNewsNext();
        else popularNewsPrevious();
      }
    }

    preloadSlideImages();

    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          isVisible = entry.isIntersecting;
          if (isVisible && !isHovered) resumeSlideTimer();
          else pauseSlideTimer();
        });
      }, { threshold: 0.5 });
      observer.observe(slider);
    } else {
      isVisible = true;
      startSlideTimer();
    }

    slider.addEventListener('mouseenter', function() {
      isHovered = true;
      pauseSlideTimer();
    });
    slider.addEventListener('mouseleave', function() {
      isHovered = false;
      if (isVisible) resumeSlideTimer();
    });

    slider.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
      isHovered = true;
      pauseSlideTimer();
    }, { passive: true });
    slider.addEventListener('touchend', function(e) {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
      isHovered = false;
      if (isVisible) resumeSlideTimer();
    }, { passive: true });

    slider.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        popularNewsPrevious();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        popularNewsNext();
      }
    });

    var dotsContainer = document.querySelector('.popular-news-dots');
    if (dotsContainer) {
      dotsContainer.addEventListener('click', function(e) {
        if (e.target.classList.contains('popular-news-dot')) {
          var slideIndex = parseInt(e.target.dataset.slide, 10);
          if (!isNaN(slideIndex)) popularNewsGoToSlide(slideIndex);
        }
      });
    }

    var prevButton = document.querySelector('.popular-arrow-prev');
    var nextButton = document.querySelector('.popular-arrow-next');
    if (prevButton) {
      prevButton.addEventListener('click', function(e) {
        e.preventDefault();
        popularNewsPrevious();
      });
    }
    if (nextButton) {
      nextButton.addEventListener('click', function(e) {
        e.preventDefault();
        popularNewsNext();
      });
    }

    window.popularNewsCleanup = function() {
      clearTimeout(slideTimeout);
      if (observer) observer.disconnect();
    };
    window.addEventListener('beforeunload', window.popularNewsCleanup);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPopularNewsSlider);
  } else {
    initPopularNewsSlider();
  }

  // Inject CMP style overrides into open shadow root when available.
  function initCmpShadowStyleOverrides() {
    var styleCss = '#cmpbox, #cmpbox * { font-family: "Rubik", Arial, sans-serif !important; font-size: 105% !important; }';

    function ensureStylesInRoot(root) {
      if (!root) return false;
      if (root.getElementById('vc-cmp-overrides')) return true;

      var style = document.createElement('style');
      style.id = 'vc-cmp-overrides';
      style.textContent = styleCss;
      root.appendChild(style);
      return true;
    }

    // Keep styles persistent if CMP rewrites shadow DOM content.
    function watchRootForReinjection(root) {
      if (!root || root.__vcCmpStyleObserverAttached) return;
      root.__vcCmpStyleObserverAttached = true;
      var rootObserver = new MutationObserver(function() {
        ensureStylesInRoot(root);
      });
      rootObserver.observe(root, { childList: true, subtree: true });
    }

    // Attempt direct injection into #cmpwrapper shadow root.
    function applyCmpShadowStyles() {
      var host = document.querySelector('#cmpwrapper');
      if (!host || !host.shadowRoot) return false;
      var ok = ensureStylesInRoot(host.shadowRoot);
      watchRootForReinjection(host.shadowRoot);
      return ok;
    }

    // Patch attachShadow to catch CMP root creation immediately.
    if (!window.__vcCmpAttachShadowPatched && Element.prototype.attachShadow) {
      window.__vcCmpAttachShadowPatched = true;
      var originalAttachShadow = Element.prototype.attachShadow;
      Element.prototype.attachShadow = function(init) {
        var root = originalAttachShadow.call(this, init);
        if (this && (this.id === 'cmpwrapper' || this.classList && this.classList.contains('cmpwrapper'))) {
          ensureStylesInRoot(root);
          watchRootForReinjection(root);
        }
        return root;
      };
    }

    if (applyCmpShadowStyles()) return;

    var maxWaitMs = 30000;
    var startTs = Date.now();

    // Polling covers the case where #cmpwrapper exists before shadowRoot is attached.
    var poll = setInterval(function() {
      if (applyCmpShadowStyles()) {
        clearInterval(poll);
        observer.disconnect();
        return;
      }
      if ((Date.now() - startTs) >= maxWaitMs) {
        clearInterval(poll);
        observer.disconnect();
      }
    }, 250);

    // Mutation observer catches late DOM inserts/replacements.
    var observer = new MutationObserver(function() {
      if (applyCmpShadowStyles()) {
        clearInterval(poll);
        observer.disconnect();
      }
    });
    observer.observe(document.documentElement, { childList: true, subtree: true });

    // Hard stop in case CMP is blocked/disabled.
    setTimeout(function() {
      clearInterval(poll);
      observer.disconnect();
    }, maxWaitMs);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCmpShadowStyleOverrides);
  } else {
    initCmpShadowStyleOverrides();
  }
})();

/* =============================================================================
   Site footer: back-to-top button (progressive enhancement — no JS required).
   ========================================================================== */
(function () {
  var SHOW_AFTER_PX = 600;

  function prefersReducedMotion() {
    return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function initFooterBackToTop() {
    var btn = document.querySelector('.site-footer__totop');
    if (!btn) return;

    var ticking = false;
    function update() {
      btn.classList.toggle('is-visible', window.scrollY > SHOW_AFTER_PX);
      ticking = false;
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    update();

    btn.addEventListener('click', function () {
      window.scrollTo({
        top: 0,
        behavior: prefersReducedMotion() ? 'auto' : 'smooth',
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooterBackToTop);
  } else {
    initFooterBackToTop();
  }
})();